# Template for scripts/setup-github-environments.sh. Copy to .github/env/<env>.env
# (git-ignored) and fill in. Never commit the filled-in copy.

# Azure app registration used by GitHub OIDC (no client secret needed)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Entra ID groups
SYNAPSE_ADMIN_GROUP_OBJECT_ID=
REPORTING_GROUP_NAME=sg-zingyestates-reporting

# Datadog Azure integration app registration
DATADOG_AZURE_TENANT_ID=
DATADOG_AZURE_CLIENT_ID=

# Secrets
DATADOG_AZURE_CLIENT_SECRET=
DD_API_KEY=
DD_APP_KEY=
SYNAPSE_MASTER_KEY_PASSWORD=
