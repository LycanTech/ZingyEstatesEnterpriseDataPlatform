{
    "name": "pl_load_synapse",
    "properties": {
        "description": "Loads gold export snapshots into the Synapse dedicated pool (synapse/dedicated/procedures).",
        "folder": {
            "name": "serving"
        },
        "parameters": {
            "run_date": {
                "type": "string"
            }
        },
        "annotations": [],
        "activities": [
            {
                "name": "Load warehouse",
                "type": "SqlServerStoredProcedure",
                "linkedServiceName": {
                    "referenceName": "ls_synapse_dedicated",
                    "type": "LinkedServiceReference"
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 120,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "storedProcedureName": "[dw].[usp_load_all]",
                    "storedProcedureParameters": {
                        "run_date": {
                            "value": {
                                "value": "@pipeline().parameters.run_date",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "storage_account": {
                            "value": {
                                "value": "@pipeline().globalParameters.storage_account",
                                "type": "Expression"
                            },
                            "type": "String"
                        }
                    }
                }
            }
        ]
    }
}
