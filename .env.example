# Copy to .env (git-ignored) for local runs. Nothing here is needed for the
# basic demo: `docker compose run --rm platform` works with an empty .env.

# Send local pipeline metrics to Datadog through the agent container:
#   docker compose --profile observability up -d datadog-agent
#   DD_AGENT_HOST=datadog-agent docker compose run --rm platform
DD_API_KEY=
DD_SITE=datadoghq.com
DD_AGENT_HOST=

# Used by the Datadog Terraform provider when planning from a workstation.
DD_APP_KEY=
